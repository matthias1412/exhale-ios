default_platform(:ios)

platform :ios do
  desc "Build a signed release and ship it to TestFlight"
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY"),
      # The secret is set straight from the .p8 file, so it holds raw PEM.
      # With base64 true, spaceship decodes that into binary and fails with
      # "string contains null byte" — which reads like a corrupt key but is
      # only a format mismatch.
      is_key_content_base64: false,
      in_house: false
    )

    # Certificates live in a separate PRIVATE repo — never in this one, which
    # is public. Read-only in CI so a runner can never rotate them, except on
    # the very first run when there is nothing there yet to read.
    first_run = ENV["SETUP_SIGNING"] == "true"
    UI.important("SETUP_SIGNING is on — match may create certificates") if first_run

    match(
      type: "appstore",
      readonly: !first_run,
      app_identifier: "com.matthias1412.exhale",
      git_url: "https://github.com/matthias1412/exhale-certificates.git",
      git_branch: "main"
    )

    # No xcodegen here: fastlane's `sh` runs from fastlane/, where there is no
    # project.yml, and the workflow has already generated the project two steps
    # earlier anyway.

    # No builds exist yet on the first upload, and without an explicit initial
    # value this raises instead of returning zero.
    next_build = latest_testflight_build_number(
      api_key: api_key,
      initial_build_number: 0
    ) + 1

    increment_build_number(
      build_number: next_build,
      xcodeproj: "Exhale.xcodeproj"
    )

    # Say it out loud. Fastlane's closing summary table reports elapsed seconds
    # per step, not values, and reading that column as a build number is an
    # easy and confident mistake to make when checking which build shipped.
    UI.important("Uploading build #{next_build} of #{lane_context[SharedValues::VERSION_NUMBER] || "1.0.0"}")

    build_app(
      scheme: "Exhale",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      clean: true
    )

    pilot(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
